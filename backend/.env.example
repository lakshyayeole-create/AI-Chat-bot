# === Gemini LLM Configuration (3 API Keys Pool) ===
GEMINI_API_KEY_1=
GEMINI_API_KEY_2=
GEMINI_API_KEY_3=
GEMINI_MODEL=gemini-2.5-flash

# === Optional Legacy LLM Fallback ===
GROQ_API_KEY=
LLM_MODEL=qwen/qwen3.8-27b

# === Semantic Cache Configuration ===
SEMANTIC_CACHE_ENABLED=true
SEMANTIC_CACHE_THRESHOLD=0.92
SEMANTIC_CACHE_TTL=3600
CACHE_FILE_PATH=data/cache.json

# === Embedding Configuration ===
EMBEDDING_MODEL=all-MiniLM-L6-v2

# === RAG Configuration ===
CHUNK_SIZE=800
CHUNK_OVERLAP=120
TOP_K=5
RETRIEVAL_SCORE_THRESHOLD=0.40

# === Qdrant Configuration ===
QDRANT_URL=https://586f9524-429a-4e42-a830-6b5bff37f946.eu-west-2-0.aws.cloud.qdrant.io:443
QDRANT_API_KEY=your_qdrant_api_key_here
QDRANT_COLLECTION_NAME=anantya_events

# === Paths ===
KNOWLEDGE_DIR=../event_info

# === CORS ===
FRONTEND_ORIGIN=http://127.0.0.1:3000

# === Server ===
HOST=0.0.0.0
PORT=8000
LOG_LEVEL=info
