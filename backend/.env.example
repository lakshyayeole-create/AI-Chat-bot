# === Gemini LLM Configuration (3 API Keys Pool) ===
GEMINI_API_KEY_1=
GEMINI_API_KEY_2=
GEMINI_API_KEY_3=
GEMINI_MODEL=gemini-2.5-flash

# === Optional Legacy LLM Fallback ===
GROQ_API_KEY=
LLM_MODEL=qwen/qwen3.8-27b

# === Semantic Cache Configuration ===
SEMANTIC_CACHE_ENABLED=true
SEMANTIC_CACHE_THRESHOLD=0.92
SEMANTIC_CACHE_TTL=3600
CACHE_FILE_PATH=data/cache.json

# === Embedding Configuration ===
EMBEDDING_MODEL=all-MiniLM-L6-v2

# === RAG Configuration ===
CHUNK_SIZE=800
CHUNK_OVERLAP=120
TOP_K=5
RETRIEVAL_SCORE_THRESHOLD=0.40

# === Qdrant Configuration ===
QDRANT_URL=local
QDRANT_API_KEY=
QDRANT_COLLECTION_NAME=anantya_events

# === Paths ===
KNOWLEDGE_DIR=../event_info

# === CORS ===
FRONTEND_ORIGIN=http://127.0.0.1:3000

# === Server ===
HOST=0.0.0.0
PORT=8001
LOG_LEVEL=info
Backend_URL = https://anantya-ai-backend-3rje.onrender.com

# === ElevenLabs Text-to-Speech (TTS) Configuration ===
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=pNInz6obpgDQGcFmaJgB
ELEVENLABS_MODEL_ID=eleven_turbo_v2_5
TTS_MAX_CONCURRENT_REQUESTS=2
TTS_QUEUE_MAX_SIZE=10
TTS_QUEUE_TIMEOUT_MS=8000
TTS_PROVIDER_TIMEOUT_MS=12000
TTS_CACHE_TTL_SECONDS=604800
TTS_AUDIO_CACHE_DIR=data/audio_cache
TTS_MAX_TEXT_LENGTH=2000

# === Cloudinary Configuration (Static Website Assets Only) ===
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# === MongoDB Configuration (User Info, Chat Logs, Contact Queries, Visitor Telemetry) ===
MONGODB_USERNAME=
MONGODB_PASSWORD=
MONGODB_URI=mongodb+srv://<user>:<password>@cluster.mongodb.net
MONGODB_DB_NAME=anantya_db

